{
    "openapi": "3.0.0",
    "info": {
        "title": "API de Gestão de Livraria",
        "version": "1.0.0",
        "description": "Documentação interativa da API REST para integração com a aplicação de gestão de livros."
    },
    "servers": [
        {
            "url": "http://localhost:3000/api",
            "description": "Servidor Local de Desenvolvimento"
        }
    ],
    "paths": {
        "/livros": {
            "get": {
                "summary": "Listar todos os livros",
                "tags": [
                    "Livros"
                ],
                "responses": {
                    "200": {
                        "description": "Lista de livros retornada com sucesso"
                    },
                    "500": {
                        "description": "Erro interno no servidor ao listar livros"
                    }
                }
            },
            "post": {
                "summary": "Cadastrar novo livro",
                "tags": [
                    "Livros"
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/CreateLivroDTO"
                            }
                        }
                    }
                },
                "responses": {
                    "201": {
                        "description": "Livro criado com sucesso"
                    },
                    "400": {
                        "description": "Dados inválidos ou campos obrigatórios ausentes"
                    },
                    "409": {
                        "description": "Já existe um Livro cadastrado com este título e autor"
                    },
                    "500": {
                        "description": "Erro interno no servidor ao cadastrar o livro"
                    }
                }
            }
        },
        "/livros/{id}": {
            "get": {
                "summary": "Buscar livro por ID",
                "tags": [
                    "Livros"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "Livro encontrado com sucesso"
                    },
                    "400": {
                        "description": "O ID informado deve ser um número válido"
                    },
                    "404": {
                        "description": "Livro não encontrado"
                    }
                }
            },
            "put": {
                "summary": "Atualizar dados de um livro",
                "tags": [
                    "Livros"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "requestBody": {
                    "required": true,
                    "content": {
                        "application/json": {
                            "schema": {
                                "$ref": "#/components/schemas/UpdateLivroDTO"
                            }
                        }
                    }
                },
                "responses": {
                    "200": {
                        "description": "Livro atualizado com sucesso"
                    },
                    "400": {
                        "description": "Dados de validação incorretos"
                    },
                    "404": {
                        "description": "Livro não encontrado para atualização"
                    },
                    "409": {
                        "description": "Conflito: Já existe outro livro com este título e autor"
                    }
                }
            },
            "delete": {
                "summary": "Remover livro por ID",
                "tags": [
                    "Livros"
                ],
                "parameters": [
                    {
                        "name": "id",
                        "in": "path",
                        "required": true,
                        "schema": {
                            "type": "integer"
                        }
                    }
                ],
                "responses": {
                    "204": {
                        "description": "Livro removido com sucesso"
                    },
                    "400": {
                        "description": "O ID informado deve ser um número válido"
                    },
                    "404": {
                        "description": "Livro não encontrado para exclusão"
                    }
                }
            }
        }
    },
    "components": {
        "schemas": {
            "Livro": {
                "type": "object",
                "properties": {
                    "id": {
                        "type": "integer",
                        "example": 1
                    },
                    "titulo": {
                        "type": "string",
                        "example": "A Hipótese do Amor"
                    },
                    "autor": {
                        "type": "string",
                        "example": "Ali Hazelwood"
                    },
                    "preco": {
                        "type": "number",
                        "example": 56.45
                    },
                    "sinopse": {
                        "type": "string",
                        "example": "Olive Smith, uma doutoranda em Biologia inventa um namoro falso com o professor Adam Carlsen para convencer sua amiga de que seguiu em frente após um ex-relacionamento."
                    },
                    "anoPublicacao": {
                        "type": "number",
                        "example": 2022
                    },
                    "createdAt": {
                        "type": "string",
                        "example": "2026-09-13T10:00:00.000Z"
                    },
                    "updatedAt": {
                        "type": "string",
                        "example": "2026-09-13T10:00:00.000Z"
                    }
                }
            },
            "CreateLivroDTO": {
                "type": "object",
                "required": [
                    "titulo",
                    "autor",
                    "preco",
                    "sinopse",
                    "anoPublicacao"
                ],
                "properties": {
                    "titulo": {
                        "type": "string",
                        "example": "A Hipótese do Amor"
                    },
                    "autor": {
                        "type": "string",
                        "example": "Ali Hazelwood"
                    },
                    "preco": {
                        "type": "number",
                        "example": 56.45
                    },
                    "sinopse": {
                        "type": "string",
                        "example": "Olive Smith, uma doutoranda em Biologia inventa um namoro falso com o professor Adam Carlsen para convencer sua amiga de que seguiu em frente após um ex-relacionamento."
                    },
                    "anoPublicacao": {
                        "type": "number",
                        "example": 2022
                    }
                }
            },
            "UpdateLivroDTO": {
                "type": "object",
                "properties": {
                    "titulo": {
                        "type": "string",
                        "example": "A Hipótese do Amor (Edição Especial)"
                    },
                    "preco": {
                        "type": "number",
                        "example": 49.90
                    },
                    "sinopse": {
                        "type": "string",
                        "example": "Texto atualizado da sinopse..."
                    }
                }
            }
        }
    }
}